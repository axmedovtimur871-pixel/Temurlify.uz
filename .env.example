# --- Public (safe in the browser; protected by row level security) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=https://temurlify.uz

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Needed to create student accounts from the admin panel and reset passwords.
SUPABASE_SERVICE_ROLE_KEY=
# Enables the AI translator (Claude). Without it the translator falls back to the dictionary.
ANTHROPIC_API_KEY=
# Comma-separated emails that become admins automatically on first sign-in.
ADMIN_EMAILS=you@example.com
