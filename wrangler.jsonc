{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "temurlify",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "temurlify" }
  ],
  "observability": { "enabled": true }
  // Secrets (set with `npx wrangler secret put NAME`, never committed):
  //   SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY, ADMIN_EMAILS
  // NEXT_PUBLIC_* values are inlined at build time, so they must be present
  // in the environment when `npm run cf:build` runs.
}
